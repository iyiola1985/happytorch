NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required before the studio desk at /admin will accept a sign-in.
# AUTH_SECRET must be a random string of at least 32 characters.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. When both are set, products, enquiries and settings are stored in
# Supabase instead of the local /data files. Never expose the service role key
# with a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
